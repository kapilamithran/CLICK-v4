{
  "name": "click-practice",
  "displayName": "CLICK Practice",
  "description": "Pair with the CLICK web app and solve C practice challenges directly in VS Code.",
  "version": "0.1.2",
  "publisher": "clicklearn",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/darshansathish2006/PUC-V2.git",
    "directory": "vscode-extension"
  },
  "activationEvents": ["onUri"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "click.pair", "title": "CLICK: Pair with Web App", "icon": "$(plug)" },
      { "command": "click.openNextPractice", "title": "CLICK: Open Next Practice" },
      { "command": "click.checkCode", "title": "CLICK: Check Code", "icon": "$(check)" },
      { "command": "click.runVisibleTests", "title": "CLICK: Run Visible Tests", "icon": "$(play)" },
      { "command": "click.disconnect", "title": "CLICK: Disconnect", "icon": "$(debug-disconnect)" },
      { "command": "click.refreshPractice", "title": "CLICK: Refresh Practice", "icon": "$(refresh)" },
      { "command": "click.resetStarterCode", "title": "CLICK: Reset Starter Code", "icon": "$(discard)" },
      { "command": "click.showQuestionPanel", "title": "CLICK: Show Question Panel", "icon": "$(book)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "click", "title": "CLICK Practice", "icon": "resources/activity-icon.svg" }
      ]
    },
    "views": {
      "click": [
        { "id": "click.questionView", "name": "Question", "type": "webview" },
        { "id": "click.practiceTree", "name": "My Assignments", "type": "tree" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "click.practiceTree",
        "contents": "Not paired with the CLICK web app yet.\n[Pair with Web App](command:click.pair)",
        "when": "!click.paired"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "click.refreshPractice", "when": "view == click.practiceTree", "group": "navigation@1" },
        { "command": "click.pair", "when": "view == click.practiceTree && !click.paired", "group": "navigation@2" },
        { "command": "click.disconnect", "when": "view == click.practiceTree && click.paired", "group": "navigation@2" }
      ],
      "editor/title": [
        { "command": "click.runVisibleTests", "when": "resourceLangId == c", "group": "navigation@1" },
        { "command": "click.checkCode", "when": "resourceLangId == c", "group": "navigation@2" },
        { "command": "click.showQuestionPanel", "when": "resourceLangId == c", "group": "navigation@3" }
      ]
    },
    "configuration": {
      "title": "CLICK Practice",
      "properties": {
        "click.backendUrl": {
          "type": "string",
          "default": "https://jnxevalckgitxuunjcvv.supabase.co/functions/v1/click-backend",
          "description": "CLICK backend endpoint."
        },
        "click.anonKey": {
          "type": "string",
          "default": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpueGV2YWxja2dpdHh1dW5qY3Z2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0OTg2OTYsImV4cCI6MjEwNDA3NDY5Nn0.AtbnOxi8sDI-jTQ1gYJy4_e5tXuHr2yG6OrJ5uYcANo",
          "description": "CLICK backend public API key."
        },
        "click.gccPath": {
          "type": "string",
          "default": "gcc",
          "description": "Path to the gcc executable (default assumes it's on PATH, e.g. via MSYS2 UCRT64)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
